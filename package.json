{
  "name": "portless-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "repository": {
    "type": "git",
    "url": "https://github.com/bbylw/portless-cn"
  },
  "homepage": "https://portless.ndjp.net/",
  "scripts": {
    "dev": "portless run vite",
    "build": "bun scripts/check-docs-sync.mjs && bun x --bun tsc && bun x --bun vite build",
    "preview": "portless run vite preview",
    "lint": "bun scripts/check-docs-sync.mjs && bun x --bun tsc --noEmit"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "^7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.4",
    "@types/bun": "^1.4.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "tailwindcss": "4.3.4",
    "typescript": "7.0.2",
    "vite": "8.3.6"
  }
}
